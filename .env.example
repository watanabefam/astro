# Tina Cloud credentials (build-time only; `tinacms build` bakes these in).
# Get them from https://tina.io -> your project.
PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Production URL — drives canonical URLs, sitemap, and OpenGraph tags.
# Astro uses the PUBLIC_ prefix (NOT NEXT_PUBLIC_).
SITE_URL=https://example.com
