---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/blocks/Hero.astro";
import Callout from "../components/blocks/Callout.astro";
import Content from "../components/blocks/Content.astro";
import { getPage, getSiteConfig } from "../lib/tina";

const page = await getPage("home.md");
const config = await getSiteConfig();
---

<Layout
  title={page.title}
  siteName={config.name}
  description={config.description}
>
  <main>
    {
      page.blocks?.map((block) => {
        // Tina identifies each block by `__typename` (e.g. PagesBlocksHero).
        if (block.__typename === "PagesBlocksHero") return <Hero block={block} />;
        if (block.__typename === "PagesBlocksCallout") return <Callout block={block} />;
        if (block.__typename === "PagesBlocksContent") return <Content block={block} />;
        return null;
      })
    }
  </main>
</Layout>
